+/* mupen64plus-VR: dual-render — present THIS pass's just-rendered buffer through
+ * GLideN64's REAL present pipeline (renderBuffer: VI crop, letterbox, aspect,
+ * overscan, field windowing, buffer-seam split blits) by pointing the VI origin at
+ * the buffer for the duration of the call. eye 0 swaps stage-only (core uploads
+ * LEFT, no XR frame, no window swap); eye 1 swaps as the present (RIGHT + XR +
+ * window). History: a raw full-FBO blit here kept the eyes coherent but showed
+ * rows the VI never displays — letterboxed scenes (GE credits) grew a garbage
+ * band across the bottom quarter and the in-level HUD glitched (field report +
+ * screenshot, 2026-07-16 22:00). Reusing renderBuffer is the only correct crop.
+ *
+ * The per-buffer VI-origin delta (the interlace field line the game programs) is
+ * remembered from real scanouts and re-applied, so the de-bob the old right eye
+ * enjoyed comes through the same math. Unknown buffer => delta 0. */
+int g_vr_composite_active = 0;   /* lets our re-entrant renderBuffer call through the dual suppress */
+
+void g_vr_composite_eye(unsigned eye)
+{
+	FrameBuffer * pBuffer = frameBufferList().getCurrent();
+	if (pBuffer == nullptr || pBuffer->m_pTexture == nullptr)
+		return;
+
+	extern void g_vr_report_eye(unsigned eye);   /* gSP.cpp */
+	extern void g_vr_set_swap_mode(int mode);    /* gSP.cpp */
+
+	/* Per-buffer origin delta, learned from what the game really programs. */
+	u32 delta = 0;
+	{
+		/* Per-buffer VI-origin delta map (per-process). 4-slot ring: a start address
+		 * with no matching and no empty slot overwrites round-robin, so a full map
+		 * keeps learning and stale entries self-heal instead of the map wedging. */
+		static u32 s_bobStart[4] = { 0, 0, 0, 0 };
+		static u32 s_bobDelta[4] = { 0, 0, 0, 0 };
+		static int s_bobNext = 0;                 /* ring write index for eviction */
+		const u32 vio = (*REG.VI_ORIGIN) & 0xFFFFFF;
+		FrameBuffer * pVIBuf = frameBufferList().findBuffer(vio);
+		if (pVIBuf != nullptr && vio >= pVIBuf->m_startAddress) {
+			const u32 d = vio - pVIBuf->m_startAddress;
+			if (d < 0x8000) {                     /* windowing offsets are small */
+				int slot = -1;
+				for (int i = 0; i < 4 && slot < 0; ++i)
+					if (s_bobStart[i] == pVIBuf->m_startAddress) slot = i;
+				for (int i = 0; i < 4 && slot < 0; ++i)
+					if (s_bobStart[i] == 0) slot = i;
+				if (slot < 0) {                       /* map full, no match: evict round-robin */
+					slot = s_bobNext;
+					s_bobNext = (s_bobNext + 1) & 3;
+				}
+				s_bobStart[slot] = pVIBuf->m_startAddress; s_bobDelta[slot] = d;
+			}
+		}
+		for (int i = 0; i < 4; ++i)
+			if (s_bobStart[i] == pBuffer->m_startAddress) { delta = s_bobDelta[i]; break; }
+	}
+
+	const u32 savedOrigin = *REG.VI_ORIGIN;
+	*REG.VI_ORIGIN = pBuffer->m_startAddress + delta;
+
+	g_vr_report_eye(eye);
+	g_vr_set_swap_mode(eye == 0u ? 1 : 0);
+	g_vr_composite_active = 1;
+	frameBufferList().renderBuffer();            /* full pipeline; swaps inside */
+	g_vr_composite_active = 0;
+	g_vr_set_swap_mode(0);
+	*REG.VI_ORIGIN = savedOrigin;
+
+	static int trace = -1;
+	if (trace < 0) trace = (getenv("MUPEN_VR_TRACE") != NULL) ? 1 : 0;
+	if (trace) {
+		static int n = 0;
+		if (n < 480)
+			fprintf(stderr, "[VRp] comp%c  #%03d start=%06x delta=%u\n",
+			        eye == 0u ? 'L' : 'R', n++, pBuffer->m_startAddress, delta);
+	}
+
+	frameBufferList().setCurrentDrawBuffer();    /* restore the draw FB for the next pass */
+}
