+float g_vr_eye  = 0.0f;   /* -1 left, +1 right */
+float g_vr_sep  = 0.0f;   /* separation */
+float g_vr_conv = 0.0f;   /* convergence (w units) */
+
+/* mupen64plus-VR: report the eye of the buffer being PRESENTED to the core
+ * (CoreVR_SetStereoEye, resolved once from the loaded core's exports). Called from
+ * FrameBufferList::renderBuffer immediately before the swap, so the core's readback
+ * hook pairs the pixels with the right eye — the tag travels with the frame. */
+#ifndef OS_WINDOWS
+#include <dlfcn.h>
+#endif
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
