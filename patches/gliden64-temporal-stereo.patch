+		resolved = 1;
+		set_mode = (set_mode_fn)g_vr_core_sym("CoreVR_SetSwapMode");
+	}
+	if (set_mode != nullptr)
+		set_mode(mode);
+#else
+	(void)mode;
+#endif
+}
