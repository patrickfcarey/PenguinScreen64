+/* mupen64plus-VR: 1 while dual-render is active (RSP.cpp sets it) — the present
+ * path then labels its eye from control flow, not the buffer tag. */
+int g_vr_dual_active = 0;
+
+/* mupen64plus-VR: clip-w distribution capture (MUPEN_VR_TRACE=1) — the calibration
+ * feed for per-game stereo convergence. Collected on LEFT-eye perspective vertices
+ * (one pass per frame, HUD/ortho already excluded by the offset gate), dumped by
+ * RSP.cpp every ~2 s as a [VRw] line with log2-bucket percentile estimates. The
+ * profile rule consuming it: convergence = p05 * 0.95 (zero-parallax sits just
+ * inside the scene's near band; everything else recedes behind the screen). */
+int g_vr_wstats_on = 0;                     /* RSP.cpp sets it from MUPEN_VR_TRACE */
+static unsigned s_wbucket[26];              /* w in [2^-6, 2^19) by frexpf exponent */
+static float    s_wmin = 0.0f, s_wmax = 0.0f;
+static unsigned s_wcount = 0;
+
+static inline void vr_wstat_add(float w)
+{
+	int e;
+	if (!(w > 0.0f)) return;                /* skip non-positive and NaN */
+	if (s_wcount == 0u) s_wmin = s_wmax = w;
+	else { if (w < s_wmin) s_wmin = w; if (w > s_wmax) s_wmax = w; }
+	(void)frexpf(w, &e);
+	e += 6;                                 /* bucket 0 == [2^-6, 2^-5) */
+	if (e < 0) e = 0; else if (e > 25) e = 25;
+	++s_wbucket[e];
+	++s_wcount;
+}
+
+static float vr_wstat_percentile(float p)
+{
+	const unsigned target = (unsigned)(p * (float)s_wcount);
+	unsigned cum = 0;
+	for (int i = 0; i < 26; ++i) {
+		cum += s_wbucket[i];
+		if (cum >= target) {
+			/* frexpf exponent e covers values [2^(e-1), 2^e); i == e+6.
+			 * Midpoint 1.5*2^(e-1) == ldexpf(1.5, i-7); clamp into the exact
+			 * observed range so coarse buckets can't report p05 > max. */
+			float est = ldexpf(1.5f, i - 7);
+			if (est < s_wmin) est = s_wmin;
+			if (est > s_wmax) est = s_wmax;
+			return est;
+		}
+	}
+	return s_wmax;
+}
+
+void g_vr_wstats_dump()
+{
+	if (s_wcount < 500u) { s_wcount = 0u; std::memset(s_wbucket, 0, sizeof(s_wbucket)); return; }
+	const float p05 = vr_wstat_percentile(0.05f);
+	std::fprintf(stderr,
+	    "[VRw] n=%u w: min=%.2f p05~%.2f p50~%.2f p95~%.2f max=%.2f -> conv hint %.2f\n",
+	    s_wcount, s_wmin, p05, vr_wstat_percentile(0.50f), vr_wstat_percentile(0.95f),
+	    s_wmax, p05 * 0.95f);
+	std::memset(s_wbucket, 0, sizeof(s_wbucket));
+	s_wcount = 0u;
+}
+
+/* mupen64plus-VR: resolve a core handshake export. dlsym(RTLD_DEFAULT) only sees
+ * the core if the front-end loaded it with RTLD_GLOBAL (most do NOT — verified:
+ * it returns NULL under stock mupen64plus-ui-console) or if the VR core promoted
+ * itself at CoreStartup. Fall back to a NOLOAD dlopen of the core by soname: it
+ * returns a handle to the ALREADY-LOADED library (loads nothing new) and dlsym
+ * on that handle always works. MUPEN_VR_TRACE=1 logs each resolution. */
+void* g_vr_core_sym(const char* name)
+{
+#ifndef OS_WINDOWS
+	void* sym = dlsym(RTLD_DEFAULT, name);
+	if (sym == nullptr) {
+		static void* core_handle = nullptr;
+		static int core_resolved = 0;
+		if (!core_resolved) {
+			core_resolved = 1;
+			static const char* const sonames[] = { "libmupen64plus.so.2", "libmupen64plusd.so.2" };
+			for (const char* s : sonames) {
+				core_handle = dlopen(s, RTLD_NOW | RTLD_NOLOAD);
+				if (core_handle != nullptr)
+					break;
+			}
+		}
+		if (core_handle != nullptr)
+			sym = dlsym(core_handle, name);
+	}
+	static int trace = -1;
+	if (trace < 0) trace = (getenv("MUPEN_VR_TRACE") != nullptr) ? 1 : 0;
+	if (trace)
+		std::fprintf(stderr, "[VRp] core symbol %s = %p\n", name, sym);
+	return sym;
+#else
+	(void)name;
+	return nullptr;
+#endif
+}
