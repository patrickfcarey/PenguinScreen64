+{
+#ifndef OS_WINDOWS
+	typedef void (*set_eye_fn)(int);
+	static set_eye_fn set_eye = nullptr;
+	static int resolved = 0;
+	if (!resolved) {
+		resolved = 1;
+		set_eye = (set_eye_fn)g_vr_core_sym("CoreVR_SetStereoEye");
+	}
+	if (set_eye != nullptr)
+		set_eye((int)eye);
+#else
+	(void)eye;
+#endif
+}
